# Python / Kaggle .gitignore
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.log
*.pot
*.mo
*.pyc

# Personal interview and resume materials (kept locally, not on public repo)
interview_cheatsheet.md
resume_bullets.md
build_full_notebook.py

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data (don't commit raw GeoTIFFs or GeoJSONs — use Kaggle dataset directly)
*.tif
*.tiff
*.geojson
*.shp
*.dbf
*.shx
*.prj
*.cpg

# Model weights (large — download/train on Kaggle)
*.pth
*.pt
*.onnx
*.h5

# Output figures and CSVs (generated by notebook)
/output/
sanity_check.png
unet_curves.png
segformer_curves.png
error_analysis.png
robustness_curves.png
drift_distributions.png
*.csv
*.zip
test_results.json
drift_results.json
split.json

# Env
.env
.venv
env/
venv/
ENV/

